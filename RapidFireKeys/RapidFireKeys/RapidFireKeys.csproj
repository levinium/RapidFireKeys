<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>rapidfire-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <!-- Release builds ship as one self-contained exe with the .NET runtime built in -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!--
    Where the "Support RapidFireKeys" menu item sends people.

    A funding handle is not a secret, but it identifies a person, and a fork
    built from source must not quietly solicit donations to whoever wrote the
    code. Left empty, as it is here, the app has no support menu item at all.

    Set it only when publishing a release:

      .\publish.ps1 -SponsorUrl "https://github.com/sponsors/<user>?frequency=one-time&amount={amount}"

    An {amount} placeholder turns the ask into a picker; without it the ask is
    a single button. See SponsorLink.
  -->
  <PropertyGroup>
    <SponsorUrl></SponsorUrl>
  </PropertyGroup>

  <ItemGroup Condition="'$(SponsorUrl)' != ''">
    <AssemblyMetadata Include="SponsorUrl" Value="$(SponsorUrl)" />
  </ItemGroup>

  <!--
    Where the app looks to see whether a newer release exists.

    Unlike SponsorUrl this has a default: a feed left out by accident is a
    silent failure, the app simply never mentions a release again. A fork
    should point these at its own releases or blank them.
  -->
  <PropertyGroup>
    <UpdateFeedUrl Condition="'$(UpdateFeedUrl)' == ''">https://api.github.com/repos/levinium/RapidFireKeys/releases/latest</UpdateFeedUrl>
    <UpdatePageUrl Condition="'$(UpdatePageUrl)' == ''">https://github.com/levinium/RapidFireKeys/releases/latest</UpdatePageUrl>
  </PropertyGroup>

  <ItemGroup Condition="'$(UpdateFeedUrl)' != ''">
    <AssemblyMetadata Include="UpdateFeedUrl" Value="$(UpdateFeedUrl)" />
    <AssemblyMetadata Include="UpdatePageUrl" Value="$(UpdatePageUrl)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RapidFireKeys.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\rapidfire-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\rapidfire-icon.ico" />
    <EmbeddedResource Include="rapidfire-icon.ico" LogicalName="rapidfire-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
